# ── Serveur ────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Mantota API (source de vérité unique) ──────────────────────────
# Base URL de l'API Mantota (Laravel). En staging : od-system-staging.
MANTOTA_API_URL=https://mantota.test/api
MANTOTA_API_KEY=
MANTOTA_TIMEOUT=10.0
MANTOTA_RETRY_MAX=3
MANTOTA_RETRY_BACKOFF=0.5

# ── AI Gateway ─────────────────────────────────────────────────────
# Fournisseurs supportés : openai, anthropic, deepseek, ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Fournisseur par défaut et fallback (docs/tracy/02-ARCHITECTURE.md §Résilience)
DEFAULT_AI_PROVIDER=openai
FALLBACK_AI_PROVIDER=ollama
AI_TEMPERATURE=0.7
AI_TIMEOUT=30.0

# ── Redis (mémoire courte, sessions) ───────────────────────────────
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MEMORY_TTL=3600

# ── Gateway (auth entrante, rate limiting) ─────────────────────────
# Clés API acceptées, séparées par des virgules
GATEWAY_API_KEYS=changeme-dev-key
RATE_LIMIT_PER_MINUTE=60

# ── Orchestrateur ──────────────────────────────────────────────────
MAX_CONVERSATION_HISTORY=20
